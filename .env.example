# ============================================
# 부동산 저평가 매물 탐지 시스템 - 환경 변수
# ============================================
# 이 파일을 복사해서 .env로 만든 뒤, 본인의 키를 입력하세요.
# cp .env.example .env  (Linux/Mac)
# copy .env.example .env  (Windows)
#
# ⚠️ .env 파일은 절대 커밋하지 마세요!

# ----- 국토교통부 실거래가 API -----
MOLIT_API_KEY=your_key_here

# ----- K-apt 공동주택관리정보 API -----
KAPT_API_KEY=your_key_here

# ----- 네이버 뉴스 검색 API -----
NAVER_CLIENT_ID=your_id_here
NAVER_CLIENT_SECRET=your_secret_here

# ----- 텔레그램 봇 알림 -----
TELEGRAM_BOT_TOKEN=your_token_here

# ----- Anthropic API (LLM 활용 시) -----
ANTHROPIC_API_KEY=your_key_here
